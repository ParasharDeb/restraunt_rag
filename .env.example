# Neon Postgres connection string — same value as backend/.env DATABASE_URL.
# Use the POOLED host (contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""
MISTRAL_EMBED_MODEL="mistral-embed"

# https://app.pinecone.io -> API Keys
PINECONE_API_KEY=""
PINECONE_INDEX="milli-milli-menu"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_NAMESPACE="items"

# Ingestion tuning. Mistral's free tier is rate limited, so keep batches modest.
EMBED_BATCH_SIZE=32
EMBED_BATCH_DELAY_SECONDS=1.0
